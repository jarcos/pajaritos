# Copiar a .env en el NAS y hacer chmod 600. NUNCA commitear el .env real.
# Generar valores, no inventarlos:  openssl rand -base64 32

# ── Aviso de reportes nuevos (SMTP de Mailgun EU, ya en uso en la casa) ──
# Por SMTP y no por la API HTTP: Mailgun solo ensena el secreto de una API key
# al crearla, y la cuenta ya tiene sus dos gastadas. Estas mismas credenciales
# ya funcionan en biblioHack y en monitoring, asi que no hay secreto nuevo que
# mantener. Se aceptan tambien SMTP_USERNAME/SMTP_PASSWORD.
SMTP_HOST=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_USER=REEMPLAZAR
SMTP_PASS=REEMPLAZAR
SMTP_FROM=                      # opcional; por defecto, el propio SMTP_USER
ALERT_EMAIL=josearcoscampos@gmail.com

# ── Antiabuso del endpoint de reportes ──
# Palabra del campo honeypot: si llega rellenado, se descarta en silencio.
HONEYPOT_FIELD=telefono
# Segundos mínimos entre apertura del formulario y envío.
MIN_FILL_SECONDS=3

# ── Opcional: token compartido para el healthcheck interno ──
INTERNAL_TOKEN=REEMPLAZAR
