# Copiar a .env en el NAS y hacer chmod 600. NUNCA commitear el .env real.
# Generar valores, no inventarlos:  openssl rand -base64 32

# ── Aviso de reportes nuevos (Mailgun EU, ya en uso en la casa) ──
MAILGUN_API_KEY=REEMPLAZAR
MAILGUN_DOMAIN=REEMPLAZAR
MAILGUN_BASE_URL=https://api.eu.mailgun.net/v3
ALERT_EMAIL=josearcoscampos@gmail.com

# ── Antiabuso del endpoint de reportes ──
# Palabra del campo honeypot: si llega rellenado, se descarta en silencio.
HONEYPOT_FIELD=telefono
# Segundos mínimos entre apertura del formulario y envío.
MIN_FILL_SECONDS=3

# ── Opcional: token compartido para el healthcheck interno ──
INTERNAL_TOKEN=REEMPLAZAR
